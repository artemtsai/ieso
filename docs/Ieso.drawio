<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel background="#0D1117" adaptiveColors="none" dx="1000" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c3" value="Watch from outside the app; ask the endpoint, not the customer" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#E6EDF3;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="700" height="30" as="geometry" /></mxCell><mxCell id="c4" value="macOS endpoint · MDM grants FDA, Accessibility and the sysext silently" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#E6EDF3;fillColor=#1C232C;strokeColor=#3D4550;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="712" height="396" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Monitored black-box app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;no source · no SDK · may crash or hang&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;dashed=1;dashPattern=6 4;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="88" width="320" height="56" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;macOS telemetry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;libproc · kqueue · FSEvents · unified log · AX&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="320" height="56" as="geometry" /></mxCell><mxCell id="c7" value="C++ sensor · separate process that survives the app crash" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#E6EDF3;fillColor=#11161D;strokeColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="680" height="260" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Process Watcher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;kqueue · FSEvents&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="56" y="208" width="150" height="56" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Resource Sampler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;libproc stats&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="222" y="208" width="150" height="56" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;Log Collector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;unified log stream&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="388" y="208" width="150" height="56" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;UI Observer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;AX probe · dialogs&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="554" y="208" width="150" height="56" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Event bus · typed, immutable events · bounded queue per event class&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="288" width="648" height="32" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b style='font-size:12px'&gt;Config and&lt;br&gt;Bootstrap&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;enroll · policy&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;(planned)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="56" y="344" width="120" height="68" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b style='font-size:12px'&gt;Anomaly&lt;br&gt;Detection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;hang · crash&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="188" y="344" width="120" height="68" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b style='font-size:12px'&gt;Diagnostics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;rings · stacks&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;signed probes&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="344" width="120" height="68" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b style='font-size:12px'&gt;PII Filter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;CloudEvents only&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColo