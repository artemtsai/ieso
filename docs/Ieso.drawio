ometry" x="276" y="532" width="208" height="64" /></mxCell><mxCell id="b_otel" vertex="1" parent="1" value="&lt;b style='font-size:13px'&gt;OTel Collector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;TLS 1.3 mTLS&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;OTLP/HTTP metrics · logs&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;"><mxGeometry as="geometry" x="512" y="532" width="208" height="64" /></mxCell><mxCell id="b_cp" vertex="1" parent="1" value="&lt;b style='font-size:13px'&gt;Control plane&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;incident index · fleet · reports&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;policy + ECDSA probe signer&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;"><mxGeometry as="geometry" x="40" y="628" width="208" height="64" /></mxCell><mxCell id="b_loki" vertex="1" parent="1" value="&lt;b style='font-size:13px'&gt;Prometheus · Loki&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;metrics · logs&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;investigation reports&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B6573;fillColor=#161B22;fontColor=#E6EDF3;fontSize=13;"><mxGeometry as="geometry" x="512" y="628" width="208" height="64" /></mxCell><mxCell id="b_inv" vertex="1" parent="1" value="&lt;b style='font-size:13px'&gt;AI investigator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;fleet diff · crash / hang dumps&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#9DA7B3'&gt;Claude / rules · watch mode&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#5B65